NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=
# "Things I Love" pinboard DB (homepage band 03). Optional: unset falls back to the photo marquee.
NOTION_LOVES_DB_ID=
NEXT_PUBLIC_SITE_URL=https://msizzle.com

# --- Things I Love auto-enrichment (npm run enrich-loves / /api/enrich-loves) ---
# TMDB (themoviedb.org) free API key — enables movie posters, director + year. Optional.
TMDB_API_KEY=
# Anthropic API key — enables AI-drafted Notes. Optional; without it Notes are left blank.
ANTHROPIC_API_KEY=
# Google Books API key — optional; raises the keyless rate limit. Books fall back to Open Library without it.
GOOGLE_BOOKS_API_KEY=
# Override the Note-drafting model (default: claude-haiku-4-5-20251001). Optional.
ENRICH_NOTE_MODEL=
# Shared secret protecting /api/enrich-loves and /api/revalidate. Required to use the routes.
# The Vercel cron authenticates via CRON_SECRET instead, so this need not be in vercel.json.
ENRICH_LOVES_TOKEN=
